# Copy to .env and adjust. Every variable is optional for local development.
# Never commit .env: it holds GitHub tokens and LLM keys.

# --- Application (read by api and worker; prefix DEVAGENT_) --------------------
# Runtime environment: development | test | production
DEVAGENT_ENVIRONMENT=development
# Minimum log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
DEVAGENT_LOG_LEVEL=INFO
# Log renderer: json (machine-readable, default) | console (human-readable)
DEVAGENT_LOG_FORMAT=json
# Async SQLAlchemy DSN. Compose builds this from the POSTGRES_* values below;
# set it only when running the API outside Compose.
DEVAGENT_DATABASE_URL=postgresql+asyncpg://devagent:devagent@localhost:5432/devagent
# Redis DSN for the arq queue and health checks (outside Compose).
DEVAGENT_REDIS_URL=redis://localhost:6379/0
# JSON list of browser origins allowed by CORS.
DEVAGENT_CORS_ORIGINS=["http://localhost:3000"]
# Per-dependency timeout for /health checks, in seconds (0 < t <= 30).
DEVAGENT_HEALTH_CHECK_TIMEOUT_SECONDS=2.0
# Seconds between SSE keepalive comments on idle event streams (0 < t <= 120).
DEVAGENT_SSE_KEEPALIVE_SECONDS=15

# --- Workspaces (worker) -----------------------------------------------------
# Directory for per-run repository checkouts.
DEVAGENT_WORKSPACE_ROOT=/tmp/devagent/workspaces
# Reject repositories larger than this many bytes or files (spec default 200 MB / 20k).
DEVAGENT_MAX_REPO_BYTES=209715200
DEVAGENT_MAX_REPO_FILES=20000
# Wall-clock limit for fetching a repository, in seconds.
DEVAGENT_CLONE_TIMEOUT_SECONDS=300

# --- Sandbox (worker; ADR 0007, ADR 0012) --------------------------------------
# Docker API endpoint. Compose points the worker at the filtering proxy
# (tcp://docker-proxy:2375). Unset = DOCKER_HOST or the local socket.
# DEVAGENT_DOCKER_HOST=
# Image every agent command runs in (built from docker/sandbox.Dockerfile).
DEVAGENT_SANDBOX_IMAGE=devagent-sandbox:dev
# uid:gid inside the sandbox; must be non-root (the proxy refuses root).
DEVAGENT_SANDBOX_USER=10001:10001
# Per-command limits.
DEVAGENT_SANDBOX_CPUS=1.0
DEVAGENT_SANDBOX_MEMORY_MB=1024
DEVAGENT_SANDBOX_PIDS=256
DEVAGENT_SANDBOX_TMPFS_MB=256
# Named volume holding DEVAGENT_WORKSPACE_ROOT (Compose sets devagent-workspaces).
# Unset = the Docker daemon can see the worker's filesystem and bind-mounts run dirs.
# DEVAGENT_SANDBOX_WORKSPACE_VOLUME=
# Network for the dependency-install step only (agent commands never get one).
# Compose also passes this to the proxy's network allowlist.
DEVAGENT_SANDBOX_INSTALL_NETWORK=bridge
# Optional HTTP(S) proxy and CA bundle for dependency installs.
# DEVAGENT_SANDBOX_INSTALL_PROXY=http://proxy.internal:3128
# DEVAGENT_SANDBOX_EXTRA_CA_FILE=/path/to/ca.pem
# Optional container runtime for sandboxes, e.g. runsc (gVisor) if installed.
# DEVAGENT_SANDBOX_RUNTIME=
# Sandbox containers older than this are removed by the reaper (crash leftovers).
DEVAGENT_SANDBOX_REAP_AFTER_SECONDS=7200
# Command allowlist, timeouts and output caps.
DEVAGENT_COMMAND_POLICY_PATH=config/command_policy.yaml

# --- LLM (worker; ADR 0014) --------------------------------------------------
# Model to use. It must have an entry in the pricing file; the entry's provider picks
# the adapter (anthropic | openai). Runs refuse to start without it.
# DEVAGENT_LLM_MODEL=
# Model prices (USD per million tokens) used for cost accounting and budgets.
DEVAGENT_LLM_PRICING_PATH=config/model_pricing.yaml
DEVAGENT_LLM_TEMPERATURE=0.0
# Upper bound on output tokens per call (also used by the worst-case budget check).
DEVAGENT_LLM_MAX_OUTPUT_TOKENS=4096
# Provider keys: only in the api/worker environment, never in the sandbox or prompts.
# DEVAGENT_ANTHROPIC_API_KEY=
# DEVAGENT_ANTHROPIC_BASE_URL=https://api.anthropic.com
# DEVAGENT_OPENAI_API_KEY=
# DEVAGENT_OPENAI_BASE_URL=https://api.openai.com
# Directory of versioned role prompts (<component>/vN.md).
DEVAGENT_PROMPTS_PATH=agent/prompts
# Cassette replayed by runs that request the "scripted" model (tests and key-free
# demos only; Compose points it at tests/cassettes/slugger_fix.yaml).
# DEVAGENT_LLM_SCRIPT_PATH=

# --- Agent (worker; ADR 0015) -------------------------------------------------
# Bundled sample repositories that can be registered with {"sample": "<name>"}.
DEVAGENT_SAMPLE_REPOS_PATH=sample_repos
# Base URL of the web UI: the run-trace link in pull request text, the OAuth
# callback (<url>/api/v1/auth/github/callback) and whether cookies are Secure (https).
DEVAGENT_PUBLIC_WEB_URL=http://localhost:3000
# Maximum tool rounds (LLM turns) per tool-using step.
DEVAGENT_AGENT_LOCALIZER_ROUNDS=12
DEVAGENT_AGENT_REPRODUCER_ROUNDS=10
DEVAGENT_AGENT_EDITOR_ROUNDS=12
# Keep run directories after a run finishes (debugging only; they hold repository code).
DEVAGENT_KEEP_WORKSPACES=false

# --- GitHub (api + worker; ADR 0017) -------------------------------------------
# Fernet key that encrypts stored GitHub tokens and signs session cookies. Required
# for sign-in. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# DEVAGENT_SECRET_KEY=
# OAuth app for "Sign in with GitHub" (github.com/settings/developers). Its callback
# URL must be <DEVAGENT_PUBLIC_WEB_URL>/api/v1/auth/github/callback. When set, every
# run and repository endpoint requires a signed-in user.
# DEVAGENT_GITHUB_CLIENT_ID=
# DEVAGENT_GITHUB_CLIENT_SECRET=
# Fine-grained personal access token, used when no user token is available (single-user
# setups without an OAuth app). Grant only the repositories you want PRs on, with
# Contents: read/write, Pull requests: read/write, Issues: read.
# DEVAGENT_GITHUB_TOKEN=
# API and web base URLs (GitHub Enterprise Server: https://<host>/api/v3 and https://<host>).
DEVAGENT_GITHUB_API_URL=https://api.github.com
DEVAGENT_GITHUB_WEB_URL=https://github.com
# Identity on DevAgent's commits.
DEVAGENT_GITHUB_COMMIT_NAME=DevAgent
DEVAGENT_GITHUB_COMMIT_EMAIL=devagent@users.noreply.github.com
# Session cookie lifetime in seconds (default 7 days).
DEVAGENT_SESSION_MAX_AGE_SECONDS=604800

# --- MCP server (python -m mcp_server; ADR 0019) --------------------------------
# DevAgent API that the MCP run-control tools call.
# DEVAGENT_MCP_API_URL=http://localhost:8000
# Value of the devagent_session cookie, only needed when GitHub sign-in is enabled.
# DEVAGENT_MCP_SESSION=

# --- Docker Compose -----------------------------------------------------------
# Postgres credentials and database name used by the postgres service.
POSTGRES_USER=devagent
POSTGRES_PASSWORD=devagent
POSTGRES_DB=devagent
# Host ports (bound to 127.0.0.1 only).
API_PORT=8000
WEB_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
# Optional PEM bundle for image builds behind a TLS-intercepting proxy.
# Passed as a BuildKit secret; never stored in images. Leave unset normally.
# DEVAGENT_BUILD_CA_FILE=/path/to/corporate-ca.pem
